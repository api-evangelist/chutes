{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chutes Chat API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Chat",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a chat completion.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://llm.chutes.ai/v1/chat/completions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "OpenAI-compatible chat completions. Reachable for any model currently running on the Chutes network via the shared endpoint https://llm.chutes.ai/v1. Set `stream: true` to receive the response as Server-Sent Events."
        }
      ]
    }
  ],
  "bundled": true
}